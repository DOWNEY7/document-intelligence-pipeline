# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# Agent scratch / internals
.agents/

# Uploaded runtime data & local databases (preserve directories via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/store/*
!data/store/.gitkeep

# Environment variables & secrets
.env
.env.local
*.pem
*.key

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
